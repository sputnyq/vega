# Lokale Entwicklungswerte. In Produktion ausschließlich Runtime-Secrets verwenden.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
BETTER_AUTH_SECRET=

# Nur für die lokale MariaDB in docker-compose.yml; niemals Produktionspasswörter.
MYSQL_PORT=3307
MYSQL_DATABASE=vega
MYSQL_USER=vega
MYSQL_PASSWORD=vega_local_dev
MYSQL_ROOT_PASSWORD=vega_local_root_dev
DATABASE_URL=mysql://vega:vega_local_dev@127.0.0.1:3307/vega

# Einmaliger Admin-Bootstrap für `npm run db:seed`; nach erfolgreichem Seed entfernen.
# root_user ist der Anzeigename; der Login erfolgt per E-Mail.
# Passwort: mindestens 8 Zeichen, mit Großbuchstabe, Kleinbuchstabe und Zahl.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
