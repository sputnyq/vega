# Lokale Entwicklungswerte. In Produktion ausschließlich Runtime-Secrets verwenden.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Nur für die lokale MariaDB in docker-compose.yml; niemals Produktionspasswörter.
MYSQL_PORT=3307
MYSQL_DATABASE=vega
MYSQL_USER=vega
MYSQL_PASSWORD=vega_local_dev
MYSQL_ROOT_PASSWORD=vega_local_root_dev
DATABASE_URL=mysql://vega:vega_local_dev@127.0.0.1:3307/vega
